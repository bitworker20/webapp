{
  "name": "bitpoker-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BitPoker web client — testnet / small-stakes only. Holds the account key in page memory; see docs/webapp-threat-model.md.",
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "dev": "npm run build:worker && vite",
    "build": "npm run build:worker && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/smoke.e2e.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "bech32": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "~5.6.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
