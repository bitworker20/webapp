{
  // NOTE ON THE TYPESCRIPT VERSION (package.json pins ~5.6.3 deliberately):
  // this build typechecks @bitpoker/poker-session through the paths below, and
  // those sources are also compiled by the Keplr extension's TypeScript 5.0.
  // TypeScript 5.7 made Uint8Array generic (Uint8Array<ArrayBufferLike>),
  // which that package's crypto code does not satisfy under 5.0's rules.
  // Staying on 5.6 keeps one source dialect; see js/poker-session/tsconfig.json
  // and bump only when the extension's TypeScript moves too.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["src"]
}
